# Values a browser is sent anyway: none of them is a secret.

# The host names whose visits are counted; a copy of the site served elsewhere is not.
VITE_UMAMI_DOMAINS=moti-oren.github.io

# The site's id from Umami's "tracking code". Until it is set, nothing is loaded or sent.
# VITE_UMAMI_WEBSITE_ID=

# The form service that feedback is posted to. Until it is set, the build offers no feedback.
# VITE_FEEDBACK_ENDPOINT=
